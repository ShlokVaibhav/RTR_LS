
@article{subramanian_119-dba_2025,
	title = {A 119-{dBA} {Dynamic} {Range}, 3.3-{mW} {Audio} {CTDSM} {With} a {Class}-{B} {Resistor} {DAC} and {Continuous}-{Time} {Quantizer}},
	volume = {60},
